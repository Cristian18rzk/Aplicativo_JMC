# ─── Airtable ──────────────────────────────────────────────
# Token personal: https://airtable.com/create/tokens
# Permisos: data.records:read, data.records:write sobre la base.
# Para `npm run auth:setup` (crear tablas) además: schema.bases:read, schema.bases:write.
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ─── Autenticación (Auth.js / NextAuth v5) ─────────────────
# Cifra los JWT de sesión y firma el token CSRF. Mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Cambiarlo invalida todas las sesiones abiertas.
AUTH_SECRET=cambie-este-valor-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# ─── Correo de recuperación de contraseña (Gmail SMTP) ─────
# SMTP_USER: la cuenta Gmail desde la que se envía.
# SMTP_PASSWORD: una "contraseña de aplicación" de 16 letras, NO la contraseña normal de Gmail.
#   Requiere la verificación en 2 pasos activa. Se crea en https://myaccount.google.com/apppasswords
# Sin estas variables en desarrollo, el correo se imprime en la consola del servidor.
SMTP_USER=nomina.jmc@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Nombre que verá el destinatario como remitente (opcional)
EMAIL_REMITENTE_NOMBRE=Nómina JMC
# Opcional, solo si usa otro servidor SMTP distinto de Gmail (por defecto smtp.gmail.com:465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ─── Aplicación ────────────────────────────────────────────
# URL pública (se usa en los enlaces de los correos y para validar el encabezado Origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Administrador inicial (opcional, para `npm run auth:seed`) ───
# Si ADMIN_PASSWORD no se define, el script la pide oculta en la terminal (recomendado).
ADMIN_EMAIL=admin@su-dominio.com
ADMIN_NOMBRE=Nombre Apellido

# ─── Datos de la empresa (desprendibles y certificados) ───
EMPRESA_NOMBRE=JMC S.A.S.
EMPRESA_NIT=900.123.456-7
EMPRESA_DIRECCION=Calle 100 # 10-20
EMPRESA_CIUDAD=Bogotá D.C.
EMPRESA_TELEFONO=(601) 123 4567
EMPRESA_REP_LEGAL=Nombre del Representante Legal
EMPRESA_CARGO_REP=Gerente General
